<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aikon_list_full_height"
    android:background="@drawable/aikon_list_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:defaultFocusHighlightEnabled="false"
    android:foreground="@drawable/aikon_list_item_focus_overlay">

    <ImageView
        android:id="@+id/aikon_list_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@android:drawable/sym_def_app_icon"/>

    <TextView
        android:id="@+id/aikon_list_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/aikon_list_padding_horizontal"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="?attr/aikonTextPrimaryColor"
        android:textSize="@dimen/aikon_list_text_size_primary"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/aikon_list_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/aikon_list_icon"
        tools:text="Название приложения"/>

    <TextView
        android:id="@+id/aikon_list_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/aikon_list_padding_horizontal"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="?attr/aikonTextSecondaryColor"
        android:textSize="@dimen/aikon_list_text_size_secondary"
        app:layout_constraintTop_toBottomOf="@id/aikon_list_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/aikon_list_icon"
        tools:text="com.aikon.example · v1.0"/>

</androidx.constraintlayout.widget.ConstraintLayout>
