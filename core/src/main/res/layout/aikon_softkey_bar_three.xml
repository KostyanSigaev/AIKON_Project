<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/aikon_btn_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:singleLine="true"
        android:clickable="true"
        android:focusable="false"
        android:background="@drawable/aikon_softkey_button_bg"
        android:textColor="?attr/aikonBarButtonTextColor"
        android:textSize="@dimen/aikon_bar_text_size"
        android:text="@string/aikon_btn_lock"/>

    <View
        android:layout_width="@dimen/aikon_bar_divider_width"
        android:layout_height="match_parent"
        android:background="?attr/aikonBarDividerColor"/>

    <TextView
        android:id="@+id/aikon_btn_center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:singleLine="true"
        android:clickable="true"
        android:focusable="false"
        android:background="@drawable/aikon_softkey_button_bg"
        android:textColor="?attr/aikonBarButtonTextColor"
        android:textSize="@dimen/aikon_bar_text_size"
        android:text="@string/aikon_btn_menu"/>

    <View
        android:layout_width="@dimen/aikon_bar_divider_width"
        android:layout_height="match_parent"
        android:background="?attr/aikonBarDividerColor"/>

    <TextView
        android:id="@+id/aikon_btn_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:singleLine="true"
        android:clickable="true"
        android:focusable="false"
        android:background="@drawable/aikon_softkey_button_bg"
        android:textColor="?attr/aikonBarButtonTextColor"
        android:textSize="@dimen/aikon_bar_text_size"
        android:text="@string/aikon_btn_favorites"/>

</merge>
