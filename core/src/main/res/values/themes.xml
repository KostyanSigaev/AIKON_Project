<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AIKONProject" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Aikon" parent="Theme.AppCompat.NoActionBar">
        <item name="aikonBarBackground">@color/aikon_bar_bg_default</item>
        <item name="aikonBarButtonTextColor">@color/aikon_bar_text_default</item>
        <item name="aikonBarButtonPressedColor">@color/aikon_bar_pressed_default</item>
        <item name="aikonBarDividerColor">@color/aikon_bar_divider_default</item>

        <!-- Прозрачный фон окна по умолчанию для ВСЕХ приложений проекта -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <!-- Явный запрет полноэкранного режима — статус-бар должен быть виден всегда -->
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>

        <item name="aikonTextPrimaryColor">@color/aikon_text_primary_default</item>
        <item name="aikonTextSecondaryColor">@color/aikon_text_secondary_default</item>

        <item name="android:windowShowWallpaper">true</item>

        <item name="aikonListItemPressedColor">@color/aikon_list_pressed_default</item>
    </style>

    <style name="Theme.Aikon.LoadingOverlay" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
    </style>
</resources>
